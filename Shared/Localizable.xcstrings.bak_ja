    "privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱、草稿、照片和下厨记录保存在本机。无需账号，没有广告、统计或云同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes, drafts, photos and cooking records stay on your device. No account, ads, analytics or cloud sync."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜、草稿、照片和下廚紀錄保存在裝置上。無需帳號，沒有廣告、分析或雲端同步。"
          }
        }
      }
    },
    "privacy.sharing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主动导出或分享时，文件才会交给你选的系统服务。食谱图、口令和家人文件省去私人备注。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files go to a service you choose when you export or share. Cards, codes and editable files omit private notes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主動匯出或分享時，檔案才會交給你選的系統服務。食譜圖、代碼和可編輯檔案會省去私人備註。"
          }
        }
      }
    },
    "privacy.store": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 处理试用凭证、购买、恢复和评分。基本食谱功能离线可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple handles trial receipts, purchases, restoration and ratings. Everyday recipe features work offline."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 處理試用憑證、購買、回復和評分。基本食譜功能可離線使用。"
          }
        }
      }
    },
