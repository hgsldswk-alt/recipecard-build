          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡常做"
          }
        }
      }
    },
    "sample.note": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄熟一点，更容易出汁。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripe tomatoes release more juice."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄熟一點，更容易出汁。"
          }
        }
      }
    },
    "sample.1.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄炒蛋"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomato & eggs"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄炒蛋"
          }
        }
      }
    },
    "sample.1.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄 2 个\n鸡蛋 3 个\n食用油 1 大勺\n盐适量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 tomatoes\n3 eggs\n1 tbsp cooking oil\nSalt to taste"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄 2 個\n雞蛋 3 個\n食用油 1 大匙\n鹽適量"
          }
        }
      }
    },
    "sample.1.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄切块，鸡蛋打散。\n热油倒入蛋液，炒到刚凝固，盛出。\n番茄炒软出汁，倒回鸡蛋，加盐翻匀。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut the tomatoes and beat the eggs.\nPour the eggs into hot oil. Cook until just set, then set aside.\nCook the tomatoes until soft. Return the eggs and season with salt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄切塊，雞蛋打散。\n熱油倒入蛋液，炒到剛凝固，盛出。\n番茄炒軟出汁，倒回雞蛋，加鹽拌勻。"
          }
        }
      }
    },
    "sample.2.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "红烧豆腐"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Braised tofu"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紅燒豆腐"
          }
        }
      }
    },
    "sample.2.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐 300 克\n酱油 1 大勺\n姜 2 片\n蒜 2 瓣\n水 100 毫升\n油 1 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g tofu\n1 tbsp soy sauce\n2 slices ginger\n2 cloves garlic\n100 ml water\n1 tbsp oil"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐 300 克\n醬油 1 大匙\n薑 2 片\n蒜 2 瓣\n水 100 毫升\n油 1 大匙"
          }
        }
      }
    },
    "sample.2.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐切块，煎到两面金黄。\n加姜蒜、酱油和水，焖 6 分钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut the tofu. Pan-fry until golden on both sides.\nAdd ginger, garlic, soy sauce and water. Simmer for 6 minutes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐切塊，煎到兩面金黃。\n加薑蒜、醬油和水，燜 6 分鐘。"
          }
        }
      }
    },
    "sample.3.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清蒸鲈鱼"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamed sea bass"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清蒸鱸魚"
          }
        }
      }
    },
    "sample.3.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鲈鱼 1 条\n姜 4 片\n葱 2 根\n酱油 2 大勺\n油 1 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 sea bass\n4 slices ginger\n2 scallions\n2 tbsp soy sauce\n1 tbsp oil"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鱸魚 1 尾\n薑 4 片\n蔥 2 根\n醬油 2 大匙\n油 1 大匙"
          }
        }
      }
    },
    "sample.3.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺姜片，水开后放入蒸锅。\n蒸熟后放葱丝，淋酱油和热油。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the fish on ginger and place it in the steamer.\nOnce cooked, add scallions, soy sauce and hot oil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋪薑片，水開後放入蒸鍋。\n蒸熟後放蔥絲，淋醬油和熱油。"
          }
        }
      }
    },
    "sample.4.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒜蓉生菜"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garlic lettuce"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蒜蓉萵苣"
          }
        }
      }
    },
    "sample.4.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生菜 300 克\n蒜 3 瓣\n油 1 大勺\n盐适量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g lettuce\n3 cloves garlic\n1 tbsp oil\nSalt to taste"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "萵苣 300 克\n蒜 3 瓣\n油 1 大匙\n鹽適量"
          }
        }
      }
    },
    "sample.4.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洗净生菜，蒜切碎。\n热油爆香蒜，加入生菜快炒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wash the lettuce and mince the garlic.\nFry the garlic briefly, then stir-fry the lettuce."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "洗淨萵苣，蒜切碎。\n熱油爆香蒜，加入萵苣快炒。"
          }
        }
      }
    },
    "sample.5.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "香菇鸡汤"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mushroom chicken soup"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "香菇雞湯"
          }
        }
      }
    },
    "sample.5.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鸡肉 500 克\n香菇 6 朵\n姜 3 片\n水 1 升\n盐适量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "500 g chicken\n6 shiitake mushrooms\n3 slices ginger\n1 liter water\nSalt to taste"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雞肉 500 克\n香菇 6 朵\n薑 3 片\n水 1 公升\n鹽適量"
          }
        }
      }
    },
    "sample.5.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鸡肉、香菇、姜片和水一起下锅。\n煮开后撇去浮沫，小火炖至鸡肉软熟，再放盐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put chicken, mushrooms, ginger and water in a pot.\nBring to a boil, skim, and simmer until tender. Season with salt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雞肉、香菇、薑片和水一起下鍋。\n煮開後撇去浮沫，小火燉至雞肉軟熟，再放鹽。"
          }
        }
      }
    },
    "sample.6.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "葱油拌面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scallion oil noodles"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蔥油拌麵"
          }
        }
      }
    },
    "sample.6.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面条 200 克\n葱 4 根\n酱油 2 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "200 g noodles\n4 scallions\n2 tbsp soy sauce"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麵條 200 克\n蔥 4 根\n醬油 2 大匙"
          }
        }
      }
    },
    "sample.6.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "煮面，捞出拌入葱油和酱油。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the noodles and toss with scallion oil and soy sauce."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "煮麵，撈出拌入蔥油和醬油。"
          }
        }
      }
    },
    "sample.7.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凉拌黄瓜"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucumber salad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "涼拌小黃瓜"
          }
        }
      }
    },
    "sample.7.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄瓜 2 根\n醋 1 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 cucumbers\n1 tbsp vinegar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小黃瓜 2 根\n醋 1 大匙"
          }
        }
      }
    },
    "sample.7.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把黄瓜拍碎，切块后加入调料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightly smash and chop the cucumbers. Toss with the dressing."
          }
        },
