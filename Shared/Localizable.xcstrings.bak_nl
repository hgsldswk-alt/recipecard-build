    },
    "sample.3.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鲈鱼 1 条\n姜 4 片\n葱 2 根\n酱油 2 大勺\n油 1 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 sea bass\n4 slices ginger\n2 scallions\n2 tbsp soy sauce\n1 tbsp oil"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鱸魚 1 尾\n薑 4 片\n蔥 2 根\n醬油 2 大匙\n油 1 大匙"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スズキ 1尾\nしょうが 4枚\nねぎ 2本\nしょうゆ 大さじ2\n油 大さじ1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "농어 1마리\n생강 4쪽\n대파 2대\n간장 2큰술\n기름 1큰술"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Wolfsbarsch\n4 Scheiben Ingwer\n2 Frühlingszwiebeln\n2 EL Sojasauce\n1 EL Öl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 lubina\n4 rodajas de jengibre\n2 cebolletas\n2 cdas de salsa de soya\n1 cda de aceite"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 bar\n4 tranches de gingembre\n2 oignons verts\n2 c. à soupe de sauce soja\n1 c. à soupe d’huile"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 robalo\n4 fatias de gengibre\n2 cebolinhas\n2 colheres (sopa) de shoyu\n1 colher (sopa) de óleo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 branzino\n4 fette di zenzero\n2 cipollotti\n2 cucchiai di salsa di soia\n1 cucchiaio d’olio"
          }
        }
      }
    },
    "sample.3.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺姜片，水开后放入蒸锅。\n蒸熟后放葱丝，淋酱油和热油。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the fish on ginger and place it in the steamer.\nOnce cooked, add scallions, soy sauce and hot oil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋪薑片，水開後放入蒸鍋。\n蒸熟後放蔥絲，淋醬油和熱油。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しょうがの上に魚をのせ、蒸し器に入れる。\n蒸し上がったらねぎ、しょうゆ、熱した油をかける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생강 위에 생선을 올려 찜기에 넣으세요.\n다 익으면 대파, 간장, 뜨거운 기름을 끼얹으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fisch auf Ingwer legen und in den Dämpfer geben.\nWenn er gar ist, Frühlingszwiebeln, Sojasauce und heißes Öl darübergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el pescado sobre el jengibre y llévalo a la vaporera.\nYa cocido, agrega cebolleta, salsa de soya y aceite caliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose le poisson sur le gingembre et passe-le à la vapeur.\nUne fois cuit, ajoute oignon vert, sauce soja et huile chaude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o peixe sobre o gengibre e leve ao vapor.\nDepois de cozido, junte cebolinha, shoyu e óleo quente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il pesce sullo zenzero e cuocilo al vapore.\nQuando è cotto, aggiungi cipollotto, salsa di soia e olio caldo."
          }
        }
      }
    },
    "sample.4.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒜蓉生菜"
          }
        },
        "en": {
