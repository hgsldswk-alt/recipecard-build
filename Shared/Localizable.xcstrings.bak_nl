    "privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱、草稿、照片和下厨记录保存在本机。无需账号，没有广告、统计或云同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes, drafts, photos and cooking records stay on your device. No account, ads, analytics or cloud sync."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜、草稿、照片和下廚紀錄保存在裝置上。無需帳號，沒有廣告、分析或雲端同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピ、下書き、写真、調理の記録はこの端末内に保存されます。アカウント、広告、分析ツール、クラウド同期はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피, 임시 저장, 사진, 요리 기록은 기기에만 남습니다. 계정, 광고, 분석, 클라우드 동기화가 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezepte, Entwürfe, Fotos und Kochverläufe bleiben auf deinem Gerät. Kein Konto, keine Werbung, keine Analyse, kein Cloud-Sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recetas, borradores, fotos y registros de cocina se quedan en tu dispositivo. Sin cuenta, anuncios, analíticas ni sincronización en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recettes, brouillons, photos et historiques de cuisine restent sur ton appareil. Pas de compte, de publicité, d’analyse ni de synchronisation cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receitas, rascunhos, fotos e registros de preparo ficam no seu dispositivo. Sem conta, anúncios, análises ou sincronização na nuvem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricette, bozze, foto e registri di cucina restano sul tuo dispositivo. Nessun account, pubblicità, analisi o sincronizzazione cloud."
          }
        }
      }
    },
    "privacy.sharing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主动导出或分享时，文件才会交给你选的系统服务。食谱图、口令和家人文件省去私人备注。粘贴菜谱链接时，由你的 iPhone 直接打开该网页读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files go to a service you choose when you export or share. Cards, codes and editable files omit private notes. Pasting a recipe link loads that page directly on your iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主動匯出或分享時，檔案才會交給你選的系統服務。食譜圖、代碼和可編輯檔案會省去私人備註。貼上食譜連結時，由你的 iPhone 直接開啟該網頁讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは書き出しや共有のときに選んだサービスへ送られます。カード、コード、編集できるファイルには個人メモは含まれません。レシピのリンクを貼り付けると、iPhoneがそのページを直接読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내거나 공유할 때 파일은 내가 고른 서비스로 갑니다. 카드, 코드, 편집 가능한 파일에는 개인 메모가 빠집니다. 레시피 링크를 붙여 넣으면 iPhone에서 그 페이지를 직접 불러옵니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Exportieren oder Teilen gehen Dateien an den Dienst, den du wählst. Karten, Codes und bearbeitbare Dateien enthalten keine privaten Notizen. Fügst du einen Rezept-Link ein, lädt dein iPhone die Seite direkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al exportar o compartir, los archivos van al servicio que elijas. Las tarjetas, códigos y archivos editables no incluyen notas privadas. Al pegar un enlace de receta, tu iPhone carga esa página directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors d’un export ou d’un partage, les fichiers vont au service que tu choisis. Les fiches, codes et fichiers modifiables n’incluent pas les notes privées. Quand tu colles un lien de recette, ton iPhone charge cette page directement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao exportar ou compartilhar, os arquivos vão para o serviço que você escolher. Cartões, códigos e arquivos editáveis não incluem notas privadas. Ao colar um link de receita, seu iPhone carrega a página diretamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando esporti o condividi, i file vanno al servizio che scegli. Schede, codici e file modificabili non includono le note private. Quando incolli il link di una ricetta, l’iPhone carica direttamente quella pagina."
          }
        }
      }
    },
    "privacy.store": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 处理试用凭证、购买、恢复和评分。基本食谱功能离线可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple handles trial receipts, purchases, restoration and ratings. Everyday recipe features work offline."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 處理試用憑證、購買、回復和評分。基本食譜功能可離線使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試しのレシート、購入、復元、評価はAppleが処理します。普段のレシピ機能はオフラインで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 영수증, 구매, 복원, 평가는 Apple이 처리합니다. 일상적인 레시피 기능은 오프라인으로 작동합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testbelege, Käufe, Wiederherstellung und Bewertungen wickelt Apple ab. Die alltäglichen Rezeptfunktionen laufen offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestiona los recibos de prueba, compras, restauraciones y calificaciones. Las funciones diarias funcionan sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gère les reçus d’essai, achats, restaurations et notes. Les fonctions du quotidien marchent hors ligne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple cuida dos recibos de teste, compras, restaurações e avaliações. As funções do dia a dia funcionam offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestisce ricevute di prova, acquisti, ripristini e valutazioni. Le funzioni quotidiane funzionano offline."
          }
        }
      }
    },
    "paywall.title": {
      "extractionState": "manual",
      "localizations": {
