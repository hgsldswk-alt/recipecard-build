          "stringUnit": {
            "state": "translated",
            "value": "2 tomates\n3 ovos\n1 colher (sopa) de óleo\nSal a gosto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2 pomodori\n3 uova\n1 cucchiaio d’olio\nSale q.b."
          }
        }
      }
    },
    "sample.1.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄切块，鸡蛋打散。\n热油倒入蛋液，炒到刚凝固，盛出。\n番茄炒软出汁，倒回鸡蛋，加盐翻匀。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut the tomatoes and beat the eggs.\nPour the eggs into hot oil. Cook until just set, then set aside.\nCook the tomatoes until soft. Return the eggs and season with salt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄切塊，雞蛋打散。\n熱油倒入蛋液，炒到剛凝固，盛出。\n番茄炒軟出汁，倒回雞蛋，加鹽拌勻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トマトを切り、卵を溶きほぐす。\n熱した油に卵を流し入れ、半熟になったら取り出す。\nトマトをやわらかくなるまで炒め、卵を戻して塩で味をととのえる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토마토를 썰고 달걀을 풀어 주세요.\n달군 기름에 달걀을 붓고 살짝 익으면 덜어 두세요.\n토마토를 부드럽게 볶고 달걀을 다시 넣어 소금으로 간하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomaten schneiden und Eier verquirlen.\nEier in heißes Öl geben, stocken lassen und herausnehmen.\nTomaten weich garen, Eier zurückgeben und salzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta los tomates y bate los huevos.\nVierte los huevos en aceite caliente. Cocina hasta que cuajen y reserva.\nCocina los tomates hasta que estén suaves. Agrega los huevos y sazona con sal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe les tomates et bats les œufs.\nVerse les œufs dans l’huile chaude. Fais-les prendre puis réserve.\nFais fondre les tomates. Ajoute les œufs et sale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corte os tomates e bata os ovos.\nDespeje os ovos no óleo quente. Cozinhe até firmar e reserve.\nRefogue os tomates até amaciar. Junte os ovos e tempere com sal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Taglia i pomodori e sbatti le uova.\nVersa le uova nell’olio caldo. Cuoci finché si rapprendono e mettile da parte.\nCuoci i pomodori finché si ammorbidiscono. Aggiungi le uova e sala."
          }
        }
      }
    },
