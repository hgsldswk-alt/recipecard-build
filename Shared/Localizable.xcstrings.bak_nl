        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이나 자동 결제가 없습니다. 영수증을 받아도 원래 체험 기간이 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Abo, keine automatische Abbuchung. Ein Beleg behält deine ursprünglichen Testdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suscripción ni cobro automático. Obtener un recibo conserva tus fechas de prueba originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans abonnement ni paiement automatique. Obtenir un reçu garde tes dates d’essai d’origine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assinatura nem cobrança automática. Obter um recibo mantém as datas originais do teste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento né addebito automatico. Ottenere una ricevuta mantiene le date di prova originali."
          }
        }
      }
    },
