    "sample.6.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面条 200 克\n葱 4 根\n酱油 2 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "200 g noodles\n4 scallions\n2 tbsp soy sauce"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麵條 200 克\n蔥 4 根\n醬油 2 大匙"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "麺 200g\nねぎ 4本\nしょうゆ 大さじ2"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면 200 g\n대파 4대\n간장 2큰술"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "200 g Nudeln\n4 Frühlingszwiebeln\n2 EL Sojasauce"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "200 g de fideos\n4 cebolletas\n2 cdas de salsa de soya"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "200 g de nouilles\n4 oignons verts\n2 c. à soupe de sauce soja"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "200 g de macarrão\n4 cebolinhas\n2 colheres (sopa) de shoyu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "200 g di noodles\n4 cipollotti\n2 cucchiai di salsa di soia"
          }
        }
      }
    },
    "sample.6.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "煮面，捞出拌入葱油和酱油。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the noodles and toss with scallion oil and soy sauce."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "煮麵，撈出拌入蔥油和醬油。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "麺をゆで、ねぎ油としょうゆであえる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면을 삶아 파기름과 간장에 비비세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nudeln kochen und mit Frühlingszwiebelöl und Sojasauce mischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuece los fideos y mézclalos con aceite de cebolleta y salsa de soya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais cuire les nouilles et mélange-les avec l’huile d’oignon vert et la sauce soja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe o macarrão e misture com óleo de cebolinha e shoyu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuoci i noodles e condiscili con olio di cipollotto e salsa di soia."
          }
        }
      }
    },
