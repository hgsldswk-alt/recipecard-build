    "sample.2.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐 300 克\n酱油 1 大勺\n姜 2 片\n蒜 2 瓣\n水 100 毫升\n油 1 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g tofu\n1 tbsp soy sauce\n2 slices ginger\n2 cloves garlic\n100 ml water\n1 tbsp oil"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐 300 克\n醬油 1 大匙\n薑 2 片\n蒜 2 瓣\n水 100 毫升\n油 1 大匙"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐 300g\nしょうゆ 大さじ1\nしょうが 2枚\nにんにく 2片\n水 100ml\n油 大さじ1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두부 300 g\n간장 1큰술\n생강 2쪽\n마늘 2쪽\n물 100 ml\n기름 1큰술"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g Tofu\n1 EL Sojasauce\n2 Scheiben Ingwer\n2 Knoblauchzehen\n100 ml Wasser\n1 EL Öl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g de tofu\n1 cda de salsa de soya\n2 rodajas de jengibre\n2 dientes de ajo\n100 ml de agua\n1 cda de aceite"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g de tofu\n1 c. à soupe de sauce soja\n2 tranches de gingembre\n2 gousses d’ail\n100 ml d’eau\n1 c. à soupe d’huile"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g de tofu\n1 colher (sopa) de shoyu\n2 fatias de gengibre\n2 dentes de alho\n100 ml de água\n1 colher (sopa) de óleo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g di tofu\n1 cucchiaio di salsa di soia\n2 fette di zenzero\n2 spicchi d’aglio\n100 ml d’acqua\n1 cucchiaio d’olio"
          }
        }
      }
    },
    "sample.2.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐切块，煎到两面金黄。\n加姜蒜、酱油和水，焖 6 分钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut the tofu. Pan-fry until golden on both sides.\nAdd ginger, garlic, soy sauce and water. Simmer for 6 minutes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐切塊，煎到兩面金黃。\n加薑蒜、醬油和水，燜 6 分鐘。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "豆腐を切り、両面がきつね色になるまで焼く。\nしょうが、にんにく、しょうゆ、水を加えて6分煮る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두부를 썰어 앞뒤로 노릇하게 부치세요.\n생강, 마늘, 간장, 물을 넣고 6분 조리세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tofu schneiden und von beiden Seiten goldbraun braten.\nIngwer, Knoblauch, Sojasauce und Wasser zugeben. 6 Minuten köcheln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta el tofu. Dóralo por ambos lados.\nAgrega jengibre, ajo, salsa de soya y agua. Cocina 6 minutos a fuego bajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe le tofu. Fais-le dorer des deux côtés.\nAjoute gingembre, ail, sauce soja et eau. Laisse mijoter 6 minutes à feu doux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corte o tofu. Doure dos dois lados.\nJunte gengibre, alho, shoyu e água. Cozinhe 6 minutos em fogo baixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Taglia il tofu. Rosolalo su entrambi i lati.\nAggiungi zenzero, aglio, salsa di soia e acqua. Cuoci 6 minuti a fuoco basso."
          }
        }
      }
    },
    "sample.3.name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清蒸鲈鱼"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamed sea bass"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清蒸鱸魚"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スズキの蒸し物"
          }
        },
        "ko": {
          "stringUnit": {
