          }
        }
      }
    },
    "sample.4.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生菜 300 克\n蒜 3 瓣\n油 1 大勺\n盐适量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g lettuce\n3 cloves garlic\n1 tbsp oil\nSalt to taste"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "萵苣 300 克\n蒜 3 瓣\n油 1 大匙\n鹽適量"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レタス 300g\nにんにく 3片\n油 大さじ1\n塩 少々"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양상추 300 g\n마늘 3쪽\n기름 1큰술\n소금 약간"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g Salat\n3 Knoblauchzehen\n1 EL Öl\nSalz nach Geschmack"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g de lechuga\n3 dientes de ajo\n1 cda de aceite\nSal al gusto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g de laitue\n3 gousses d’ail\n1 c. à soupe d’huile\nSel selon le goût"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g de alface\n3 dentes de alho\n1 colher (sopa) de óleo\nSal a gosto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "300 g di lattuga\n3 spicchi d’aglio\n1 cucchiaio d’olio\nSale q.b."
          }
        }
      }
    },
    "sample.4.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洗净生菜，蒜切碎。\n热油爆香蒜，加入生菜快炒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wash the lettuce and mince the garlic.\nFry the garlic briefly, then stir-fry the lettuce."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "洗淨萵苣，蒜切碎。\n熱油爆香蒜，加入萵苣快炒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レタスを洗い、にんにくをみじん切りにする。\nにんにくをさっと炒め、レタスを加えて炒める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양상추를 씻고 마늘을 다지세요.\n마늘을 살짝 볶은 뒤 양상추를 볶으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Salat waschen und Knoblauch hacken.\nKnoblauch kurz anbraten, dann den Salat pfannenrühren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava la lechuga y pica el ajo.\nSofríe el ajo un momento y saltea la lechuga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave la laitue et hache l’ail.\nFais revenir l’ail un instant puis saute la laitue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave a alface e pique o alho.\nRefogue o alho rapidamente e salteie a alface."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava la lattuga e trita l’aglio.\nSoffriggi brevemente l’aglio e salta la lattuga."
          }
        }
      }
    },
    "sample.5.name": {
