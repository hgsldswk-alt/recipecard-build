    "sample.7.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄瓜 2 根\n醋 1 大勺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 cucumbers\n1 tbsp vinegar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小黃瓜 2 根\n醋 1 大匙"
          }
        },
