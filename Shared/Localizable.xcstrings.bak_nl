    "sample.7.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把黄瓜拍碎，切块后加入调料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightly smash and chop the cucumbers. Toss with the dressing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把小黃瓜拍碎，切塊後加入調味料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きゅうりを軽くたたいて切り、たれであえる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오이를 살짝 두드려 썰고 양념에 무치세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gurken leicht andrücken, schneiden und mit dem Dressing mischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplasta un poco los pepinos, córtalos y mézclalos con el aliño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrase légèrement les concombres, coupe-les et mélange avec l’assaisonnement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amasse levemente os pepinos, corte e misture com o tempero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiaccia leggermente i cetrioli, tagliali e condiscili."
          }
        }
      }
    },
