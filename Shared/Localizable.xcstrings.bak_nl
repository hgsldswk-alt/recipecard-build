    "sample.5.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鸡肉 500 克\n香菇 6 朵\n姜 3 片\n水 1 升\n盐适量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "500 g chicken\n6 shiitake mushrooms\n3 slices ginger\n1 liter water\nSalt to taste"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雞肉 500 克\n香菇 6 朵\n薑 3 片\n水 1 公升\n鹽適量"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鶏肉 500g\nしいたけ 6個\nしょうが 3枚\n水 1L\n塩 少々"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닭고기 500 g\n표고버섯 6개\n생강 3쪽\n물 1리터\n소금 약간"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "500 g Hähnchen\n6 Shiitake\n3 Scheiben Ingwer\n1 Liter Wasser\nSalz nach Geschmack"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "500 g de pollo\n6 setas shiitake\n3 rodajas de jengibre\n1 litro de agua\nSal al gusto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "500 g de poulet\n6 champignons shiitake\n3 tranches de gingembre\n1 litre d’eau\nSel selon le goût"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "500 g de frango\n6 cogumelos shiitake\n3 fatias de gengibre\n1 litro de água\nSal a gosto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "500 g di pollo\n6 funghi shiitake\n3 fette di zenzero\n1 litro d’acqua\nSale q.b."
          }
        }
      }
    },
    "sample.5.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鸡肉、香菇、姜片和水一起下锅。\n煮开后撇去浮沫，小火炖至鸡肉软熟，再放盐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put chicken, mushrooms, ginger and water in a pot.\nBring to a boil, skim, and simmer until tender. Season with salt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雞肉、香菇、薑片和水一起下鍋。\n煮開後撇去浮沫，小火燉至雞肉軟熟，再放鹽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鶏肉、しいたけ、しょうが、水を鍋に入れる。\n沸騰したらアクを取り、やわらかくなるまで煮て塩で味をととのえる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닭, 표고, 생강, 물을 냄비에 넣으세요.\n끓으면 거품을 걷고 부드러워질 때까지 끓여 소금으로 간하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hähnchen, Pilze, Ingwer und Wasser in einen Topf geben.\nAufkochen, abschäumen und köcheln, bis alles zart ist. Salzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon pollo, setas, jengibre y agua en una olla.\nLleva a hervor, espuma y cocina hasta que esté tierno. Sazona con sal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets poulet, champignons, gingembre et eau dans une marmite.\nPorte à ébullition, écume et laisse cuire jusqu’à ce que ce soit tendre. Sale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque frango, cogumelos, gengibre e água numa panela.\nFerva, retire a espuma e cozinhe até ficar macio. Tempere com sal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti pollo, funghi, zenzero e acqua in una pentola.\nPorta a bollore, schiuma e cuoci finché è tenero. Sala."
          }
        }
      }
    },
