    "sample.10.steps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "煮开水，加入白菜和豆腐，煮熟后调味。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boil the water. Add cabbage and tofu, simmer and season."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "煮開水，加入白菜和豆腐，煮熟後調味。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "湯を沸かし、白菜と豆腐を入れて煮て味をととのえる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물을 끓여 배추와 두부를 넣고 끓인 뒤 간하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser aufkochen. Kohl und Tofu zugeben, köcheln und abschmecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierve el agua. Agrega col y tofu, cocina y sazona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais bouillir l’eau. Ajoute chou et tofu, laisse cuire et assaisonne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferva a água. Junte repolho e tofu, cozinhe e tempere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta l’acqua a bollore. Aggiungi cavolo e tofu, cuoci e condisci."
          }
        }
      }
    },
