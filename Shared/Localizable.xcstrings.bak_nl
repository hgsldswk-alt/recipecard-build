    "paywall.intro": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从第一次打开收费版起，高级功能可试用 30 天。之后可一次买断。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Pro for 30 days from your first launch of the paid edition. Unlock it afterward with a one-time purchase."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從第一次開啟收費版起，進階功能可試用 30 天。之後可一次買斷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有料版を初めて起動した日から30日間Proをお試しいただけます。その後は一度の購入で解放できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유료 버전을 처음 연 날부터 30일 동안 Pro를 써 보세요. 이후 한 번 구매로 잠금 해제할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste Pro 30 Tage ab dem ersten Start der Kaufversion. Danach mit einem Einmalkauf freischalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba Pro 30 días desde el primer uso de la edición de pago. Después desbloquéalo con una compra única."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
