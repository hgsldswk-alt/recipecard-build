    "editor.pasteHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法分段的文字已放到自用备注。要分享的内容可以移到食材或做法。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsorted text is in Private notes. Move anything you want to share into Ingredients or Steps."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法分段的文字已放入私人備註。要分享的內容可以移到食材或作法。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り分けられなかった文は個人メモに入っています。共有したい内容は材料か作り方に移してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분류되지 않은 텍스트는 개인 메모에 있습니다. 공유할 내용은 재료나 조리 순서로 옮기세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht zugeordneter Text steht in den privaten Notizen. Verschiebe, was du teilen willst, zu Zutaten oder Zubereitung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto sin ordenar está en Notas privadas. Mueve lo que quieras compartir a Ingredientes o Pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
