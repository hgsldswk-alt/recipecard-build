          "stringUnit": {
            "state": "translated",
            "value": "きゅうり 2本\n酢 大さじ1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오이 2개\n식초 1큰술"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Gurken\n1 EL Essig"
          }
        },
        "es": {
