    "paywall.footer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无订阅，到期不会扣费。领取凭证不会重置 30 天试用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No subscription or automatic charge. Claiming a receipt keeps your original trial dates."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有訂閱，到期不會扣款。領取憑證會保留原本的試用日期。"
          }
        },
        "ja": {
          "stringUnit": {
